# Map Assistant backend environment template
# ⚠️ 本文件是「键位说明」，值为占位符。真实生产值请填入 backend/.env
#    （backend/.env 已被 .gitignore 忽略，严禁把真实口令写进本文件或任何源码）。

# FastAPI
PORT=8006
APP_PORT=8006

# GeoServer REST proxy (/api/geoserver/**)
GEOSERVER_URL=http://127.0.0.1:8088/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=change_me
GEOSERVER_WORKSPACE=map_assistant

# GeoServer PostGIS stores
GEOSERVER_PG_HOST=172.136.16.52
GEOSERVER_PG_PORT=5432
GEOSERVER_PG_DB=postgres
GEOSERVER_PG_USER=postgres
GEOSERVER_PG_PASSWORD=<填入生产口令，禁止明文入库>
GEOSERVER_PG_SCHEMA_OVERLAY=overlay
GEOSERVER_PG_SCHEMA_BUSINESS=public

# ── 知识库后端配置 ──
# 可选值: ragflow（默认）| llamaindex
KNOWLEDGE_BACKEND=ragflow

# LlamaIndex 配置（仅 KNOWLEDGE_BACKEND=llamaindex 时生效）
LLAMAINDEX_PERSIST_DIR=./llama_index_storage
LLAMAINDEX_EMBED_MODEL=text-embedding-v3

# ── 向量库后端（仅 KNOWLEDGE_BACKEND=llamaindex 时生效）──
# simple=本地 JSON 索引（默认，单机小数据）| milvus=Milvus 服务（推荐生产）
# KB_VECTOR_BACKEND=simple
# Milvus standalone 服务地址与 collection（需先跑 scripts/migrate_kb_to_milvus.py 迁移）
# MILVUS_URI=http://127.0.0.1:19530
# KB_MILVUS_COLLECTION=map_kb
# 启动自愈：0=关闭 1=快速巡检（id/fp 对比） full=全量修复
# KB_MILVUS_AUTOSYNC=1
# 稀疏向量（jieba+BM25 混合检索）与 HNSW ef 检索参数
# KB_SPARSE_ENABLE=1
# KB_MILVUS_EF=64

# ── API Keys（真实值只放 .env；此处占位）──
DASHSCOPE_API_KEY=<填 DashScope sk- Key>
RAGFLOW_API_KEY=<填 RagFlow Key>
RAGFLOW_API_BASE=http://172.136.16.14:8080/api/v1
RAGFLOW_DATASET_ID=<填 dataset id>
DIFY_KNOWLEDGE_API_KEY=<填 Dify dataset Key>
DIFY_API_BASE=http://172.136.16.52:83/v1
DIFY_DATASET_ID=<填 Dify dataset id>
TIANDITU_TOKEN=<填天地图浏览器/服务端 Key>
WEATHER_API_KEY=<填和风天气 Key>

# ── 运行开关 ──
USE_INTENT_AGENT=true
CUDA_VISIBLE_DEVICES=0
# HuggingFace 镜像（国内环境）
HF_ENDPOINT=https://hf-mirror.com

# ── 微服务架构（P0/工具中台）──
# SQLite 会话库路径（默认 backend/sessions.db）
# MAPASSIST_DB_PATH=
# Falcon 常驻推理服务与运行环境
FALCON_SERVICE_URL=http://127.0.0.1:8765
# FALCON_PYTHON_BIN=/home/szgczx/miniconda3/envs/mapagent6/bin/python
# 工具中台 :8011 / 意图服务 :8010（不配 = 进程内回退）
TOOL_HUB_URL=http://127.0.0.1:8011
INTENT_SERVICE_URL=http://127.0.0.1:8010

# ── P1 质量评审（critic）──
# 总开关（0=关闭，行为与 P1 前一致）
CRITIC_ENABLED=1
# 评审模型（默认 qwen-flash）
CRITIC_MODEL=qwen-flash
# 最大修正轮数（1=生成→评审→修正→评审→结束）
CRITIC_MAX_ROUNDS=1
# 评审超时（秒）
CRITIC_TIMEOUT=12
# 超长响应跳过评审（字符数上限）
CRITIC_MAX_RESPONSE_CHARS=6000
