# Map Assistant frontend environment template
# ⚠️ 真实值填入 frontend/.env（已被 .gitignore 忽略）；本文件仅占位说明。
PORT=3004
# 禁用浏览器自动打开（PM2 下使用）
BROWSER=none
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Cesium Ion token（3D 地图底图）
REACT_APP_CESIUM_ION_TOKEN=<填 Cesium Ion 默认资源 token>
# 天地图 token（如前端底图启用）
REACT_APP_TIANDITU_TOKEN=<填天地图浏览器 Key>
